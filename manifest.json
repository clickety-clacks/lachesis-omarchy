{
  "schemaVersion": 1,
  "id": "mike.lachesis-usage",
  "name": "Lachesis Usage",
  "version": "1.0.0",
  "author": "Mike",
  "description": "Active Codex and Claude usage with reset-aware runway estimates from Lachesis.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "AI account usage",
    "description": "Active account percentages in the bar, with usage, runway estimates, and compatible pools in the panel.",
    "category": "AI",
    "aliases": ["lachesis", "account-usage", "ai-accounts"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "host": "localhost",
      "user": "",
      "refreshIntervalSec": 300
    },
    "schema": [
      { "key": "host", "type": "string", "label": "Lachesis host", "defaultValue": "localhost" },
      { "key": "user", "type": "string", "label": "SSH user", "defaultValue": "" },
      { "key": "refreshIntervalSec", "type": "integer", "label": "Refresh interval (seconds)", "min": 30, "max": 3600, "step": 30, "defaultValue": 300 }
    ]
  }
}
